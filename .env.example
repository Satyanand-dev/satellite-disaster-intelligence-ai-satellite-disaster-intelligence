# =====================================================================
# AI-Powered Satellite Disaster Intelligence & Emergency Response System
# Copy to .env and fill in values. NEVER commit .env.
# =====================================================================

# ---------- Database (PostGIS) ----------
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/disaster_intel

# ---------- Cache / job queue ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Auth ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173

# ---------- Uploads / processing ----------
MAX_UPLOAD_MB=512
MAX_PIXEL_COUNT=500000000
AOI_MAX_AREA_KM2=25000
MIN_POLYGON_AREA_M2=500

# ---------- Report LLM (optional — template fallback used when empty) ----------
# Works with OpenAI, Groq, or any OpenAI-compatible endpoint (e.g. local Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15

# ---------- Risk engine weights (must sum to 1.0) ----------
RISK_WEIGHT_SEVERITY=0.40
RISK_WEIGHT_POPULATION=0.25
RISK_WEIGHT_INFRASTRUCTURE=0.25
RISK_WEIGHT_ACCESSIBILITY=0.10

# ---------- Model weights ----------
FLOOD_MODEL_DIR=data/models/flood_unet_v1
INFERENCE_DEVICE=cpu

# ---------- Storage ----------
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=data

# ---------- App ----------
APP_ENV=development
LOG_LEVEL=INFO
